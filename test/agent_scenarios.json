{
  "schema_version": 2,
  "description": "Litminer contract test scenarios. Offline scenarios are deterministic and CI-safe. Known-issue scenarios track regressions as xfail. Live scenarios verify real API integration and run manually.",
  "scenarios": [
    {
      "id": "offline_smoke_first_run",
      "profiles": ["offline", "smoke"],
      "user_prompt": "I am on a new machine. Check whether Litminer can run locally before doing any live retrieval.",
      "dimensions": ["environment", "first_run", "artifact_contract", "cross_artifact_consistency"],
      "agent_expectation": {
        "skill_should_be_used": true,
        "surface": "cli",
        "mode": "offline_smoke",
        "must_read_first": ["agent_summary.json", "processing_report.md"],
        "_note": "This field documents intended Agent reasoning. It is not validated by the runner."
      },
      "command": [
        "{python}", "-m", "litminer.engine.offline_smoke",
        "--output-dir", "{output_dir}",
        "--json"
      ],
      "expect": {
        "exit_code": 0,
        "files_exist": [
          "{output_dir}/agent_summary.json",
          "{output_dir}/processing_report.md",
          "{output_dir}/result_profile.json",
          "{output_dir}/publisher_queue.csv",
          "{output_dir}/run_manifest.json",
          "{output_dir}/artifacts_index.json"
        ],
        "json": [
          {
            "path": "{output_dir}/agent_summary.json",
            "checks": [
              {"path": "run_status", "equals": "completed"},
              {"path": "partial", "equals": false},
              {"path": "trust_tiers.discovered_or_deduped", "equals": 2},
              {"path": "trust_tiers.publisher_queue", "equals": 1},
              {"path": "stage_status_classes.triage", "equals": "ok"}
            ]
          },
          {
            "path": "{output_dir}/result_profile.json",
            "checks": [
              {"path": "degraded", "equals": false},
              {"path": "all_rows.total_rows", "equals": 2}
            ]
          },
          {
            "path": "{output_dir}/run_manifest.json",
            "checks": [
              {"path": "run_status", "equals": "completed"}
            ]
          }
        ],
        "csv": [
          {
            "path": "{output_dir}/triaged_candidates.csv",
            "row_count": 2,
            "counts": {
              "triage_priority": {"high": 1, "low": 1},
              "metadata_status": {"ok": 1, "blocked": 1}
            }
          }
        ]
      }
    },
    {
      "id": "local_csv_fast_semantic_safety",
      "profiles": ["offline", "semantic", "safety"],
      "user_prompt": "Use Litminer on my candidate CSV. I need external validation evidence, benchmarks are helpful, and reviews should not be queued. Treat abstracts as evidence only.",
      "dimensions": ["local_csv", "semantic_triage", "prompt_injection", "negative_concepts", "queue"],
      "agent_expectation": {
        "skill_should_be_used": true,
        "surface": "cli",
        "mode": "fast",
        "must_not": ["follow_abstract_instructions", "claim_crossref_verified_facts"],
        "_note": "The fixture contains a prompt injection string in a review abstract. The pipeline must not follow it. Verified by checking that the injecting row is tagged negative and demoted to low priority."
      },
      "command": [
        "{python}", "-m", "litminer.engine.run_lit_search",
        "--mode", "fast",
        "--input-csv", "{fixture_mixed}",
        "--required-concept", "validation=external validation|prospective validation",
        "--optional-concept", "benchmark=benchmark|dataset",
        "--negative-concept", "review=review|survey",
        "--exclude-article-type", "review",
        "--fields-needed", "validation evidence",
        "--output-dir", "{output_dir}"
      ],
      "expect": {
        "exit_code": 0,
        "files_exist": [
          "{output_dir}/agent_summary.json",
          "{output_dir}/triaged_candidates.csv",
          "{output_dir}/publisher_queue.csv",
          "{output_dir}/query_plan.json",
          "{output_dir}/run_manifest.json"
        ],
        "files_not_exist": ["{output_dir}/oa_annotated_candidates.csv"],
        "json": [
          {
            "path": "{output_dir}/agent_summary.json",
            "checks": [
              {"path": "run_status", "equals": "completed"},
              {"path": "trust_tiers.discovered_or_deduped", "equals": 5},
              {"path": "trust_tiers.crossref_trusted", "equals": 0},
              {"path": "trust_tiers.publisher_queue", "equals": 3},
              {"path": "stage_status_classes.crossref", "equals": "skipped"},
              {"path": "stage_status_classes.unpaywall", "equals": "skipped"}
            ]
          }
        ],
        "csv": [
          {
            "path": "{output_dir}/triaged_candidates.csv",
            "row_count": 5,
            "counts": {
              "triage_priority": {"high": 2, "medium": 2, "low": 1},
              "metadata_status": {"ok": 3, "blocked": 2},
              "candidate_status": {"ready_for_verification": 3, "metadata_blocked": 2}
            }
          },
          {
            "path": "{output_dir}/publisher_queue.csv",
            "row_count": 3,
            "counts": {
              "metadata_status": {"ok": 3},
              "candidate_status": {"ready_for_verification": 3}
            }
          }
        ]
      }
    },
    {
      "id": "missing_unpaywall_email_degrades",
      "profiles": ["offline", "recovery", "access"],
      "user_prompt": "Continue with OA/access annotation, but the environment has no contact email. Do not infer that papers are inaccessible.",
      "dimensions": ["unpaywall", "missing_email", "partial_status", "cache_disabled"],
      "agent_expectation": {
        "skill_should_be_used": true,
        "surface": "cli",
        "mode": "balanced",
        "must_report": ["skipped_missing_email", "partial_auth"],
        "_note": "This field documents intended Agent reasoning. It is not validated by the runner."
      },
      "env": {
        "unset": ["UNPAYWALL_EMAIL", "LITMINER_CONTACT_EMAIL"]
      },
      "command": [
        "{python}", "-m", "litminer.engine.run_lit_search",
        "--mode", "balanced",
        "--input-csv", "{fixture_mixed}",
        "--skip-crossref",
        "--enrich-unpaywall",
        "--no-cache",
        "--required-concept", "validation=external validation|prospective validation",
        "--optional-concept", "benchmark=benchmark|dataset",
        "--negative-concept", "review=review|survey",
        "--output-dir", "{output_dir}"
      ],
      "expect": {
        "exit_code": 0,
        "stderr_contains": ["skipped_missing_email: 3"],
        "files_exist": [
          "{output_dir}/agent_summary.json",
          "{output_dir}/oa_annotated_candidates.csv",
          "{output_dir}/publisher_queue.csv"
        ],
        "json": [
          {
            "path": "{output_dir}/agent_summary.json",
            "checks": [
              {"path": "run_status", "equals": "partial"},
              {"path": "partial", "equals": true},
              {"path": "stage_status_classes.unpaywall", "equals": "auth"}
            ]
          }
        ],
        "csv": [
          {
            "path": "{output_dir}/oa_annotated_candidates.csv",
            "row_count": 3,
            "counts": {
              "unpaywall_status": {"skipped_missing_email": 3}
            }
          }
        ]
      }
    },
    {
      "id": "resume_mismatch_rejected",
      "profiles": ["offline", "recovery", "resume"],
      "user_prompt": "Resume the previous run, but I changed the required concept. The Agent should not silently reuse the old run.",
      "dimensions": ["resume", "signature_mismatch", "safety"],
      "agent_expectation": {
        "skill_should_be_used": true,
        "surface": "cli",
        "must_refuse_wrong_resume": true,
        "_note": "This field documents intended Agent reasoning. It is not validated by the runner."
      },
      "setup_commands": [
        [
          "{python}", "-m", "litminer.engine.run_lit_search",
          "--mode", "fast",
          "--input-csv", "{fixture_mixed}",
          "--required-concept", "validation=external validation|prospective validation",
          "--stop-after-stage", "dedupe",
          "--output-dir", "{output_dir}"
        ]
      ],
      "command": [
        "{python}", "-m", "litminer.engine.run_lit_search",
        "--mode", "fast",
        "--resume",
        "--input-csv", "{fixture_mixed}",
        "--required-concept", "deployment=deployment drift|clinical deployment",
        "--output-dir", "{output_dir}"
      ],
      "expect": {
        "exit_code": 1,
        "stderr_contains": ["Cannot resume because current request parameters differ"],
        "files_exist": ["{output_dir}/run_manifest.json"]
      }
    },
    {
      "id": "resume_happy_path_completes",
      "profiles": ["offline", "resume", "workflow"],
      "user_prompt": "I interrupted a fast run after dedupe. Resume it with the same parameters to complete triage and queue.",
      "dimensions": ["resume", "multi_step_workflow", "artifact_contract"],
      "agent_expectation": {
        "skill_should_be_used": true,
        "surface": "cli",
        "must_read_first": ["agent_summary.json"],
        "_note": "Tests the most common Agent workflow: initial partial run then resume to completion. Verifies that completed stages are reused and the final artifacts are consistent."
      },
      "setup_commands": [
        [
          "{python}", "-m", "litminer.engine.run_lit_search",
          "--mode", "fast",
          "--input-csv", "{fixture_mixed}",
          "--required-concept", "validation=external validation|prospective validation",
          "--optional-concept", "benchmark=benchmark|dataset",
          "--negative-concept", "review=review|survey",
          "--stop-after-stage", "dedupe",
          "--output-dir", "{output_dir}"
        ]
      ],
      "command": [
        "{python}", "-m", "litminer.engine.run_lit_search",
        "--mode", "fast",
        "--resume",
        "--input-csv", "{fixture_mixed}",
        "--required-concept", "validation=external validation|prospective validation",
        "--optional-concept", "benchmark=benchmark|dataset",
        "--negative-concept", "review=review|survey",
        "--output-dir", "{output_dir}"
      ],
      "expect": {
        "exit_code": 0,
        "files_exist": [
          "{output_dir}/agent_summary.json",
          "{output_dir}/triaged_candidates.csv",
          "{output_dir}/publisher_queue.csv",
          "{output_dir}/run_manifest.json",
          "{output_dir}/result_profile.json"
        ],
        "json": [
          {
            "path": "{output_dir}/agent_summary.json",
            "checks": [
              {"path": "run_status", "equals": "completed"},
              {"path": "partial", "equals": false},
              {"path": "trust_tiers.discovered_or_deduped", "equals": 5}
            ]
          },
          {
            "path": "{output_dir}/run_manifest.json",
            "checks": [
              {"path": "run_status", "equals": "completed"}
            ]
          },
          {
            "path": "{output_dir}/result_profile.json",
            "checks": [
              {"path": "degraded", "equals": false},
              {"path": "all_rows.total_rows", "equals": 5}
            ]
          }
        ],
        "csv": [
          {
            "path": "{output_dir}/triaged_candidates.csv",
            "row_count": 5,
            "counts": {
              "triage_priority": {"high": 2, "medium": 2, "low": 1}
            }
          }
        ]
      }
    },
    {
      "id": "websearch_import_is_unverified",
      "profiles": ["offline", "websearch"],
      "user_prompt": "I have WebSearch leads. Normalize them, but keep them as supplemental leads until verified.",
      "dimensions": ["websearch", "supplemental_leads", "normalization"],
      "agent_expectation": {
        "skill_should_be_used": true,
        "surface": "cli",
        "must_report": ["web_search_source", "needs_verification"],
        "_note": "This field documents intended Agent reasoning. It is not validated by the runner."
      },
      "command": [
        "{python}", "-m", "litminer.engine.websearch_import",
        "--input", "{fixture_websearch}",
        "--output", "{output_dir}/websearch_imported.csv",
        "--query", "fallback validation query"
      ],
      "expect": {
        "exit_code": 0,
        "stdout_contains": ["WebSearch import: 3 rows"],
        "files_exist": ["{output_dir}/websearch_imported.csv"],
        "csv": [
          {
            "path": "{output_dir}/websearch_imported.csv",
            "row_count": 3,
            "counts": {
              "discovery_source": {"websearch": 3}
            }
          }
        ]
      }
    },
    {
      "id": "zero_result_degrades_to_failure_summary",
      "profiles": ["offline", "recovery"],
      "user_prompt": "Run a search that returns zero candidates. The Agent should see a degraded result profile, not an empty success.",
      "dimensions": ["zero_results", "degradation", "result_profile"],
      "agent_expectation": {
        "skill_should_be_used": true,
        "surface": "cli",
        "must_report": ["degraded", "failure_summary"],
        "_note": "When zero candidates remain after processing, result_profile must degrade to failure_summary so the Agent does not mistake an empty result for a successful search."
      },
      "command": [
        "{python}", "-m", "litminer.engine.run_lit_search",
        "--mode", "fast",
        "--input-csv", "{fixture_empty}",
        "--output-dir", "{output_dir}"
      ],
      "expect": {
        "exit_code": 0,
        "files_exist": [
          "{output_dir}/agent_summary.json",
          "{output_dir}/processing_report.md",
          "{output_dir}/run_manifest.json"
        ],
        "json": [
          {
            "path": "{output_dir}/agent_summary.json",
            "checks": [
              {"path": "trust_tiers.discovered_or_deduped", "equals": 0}
            ]
          },
          {
            "path": "{output_dir}/result_profile.json",
            "checks": [
              {"path": "degraded", "equals": true}
            ]
          }
        ]
      }
    },
    {
      "id": "live_openalex_response_parses",
      "profiles": ["live"],
      "user_prompt": "Run a minimal OpenAlex query to verify that real API responses can be parsed correctly.",
      "dimensions": ["provider_integration", "openalex", "response_parsing"],
      "agent_expectation": {
        "skill_should_be_used": true,
        "surface": "cli",
        "_note": "Verifies that Litminer's request construction and response parsing work with the current real OpenAlex API. Run manually after source wrapper changes."
      },
      "timeout_seconds": 30,
      "command": [
        "{python}", "-m", "litminer.engine.api_discovery",
        "--query", "photocatalytic hydrogen production",
        "--sources", "openalex",
        "--max-results-per-query", "3",
        "--output", "{output_dir}/openalex_live.csv",
        "--trace-output", "{output_dir}/openalex_live_trace.csv"
      ],
      "expect": {
        "exit_code": 0,
        "files_exist": [
          "{output_dir}/openalex_live.csv",
          "{output_dir}/openalex_live_trace.csv"
        ],
        "csv": [
          {
            "path": "{output_dir}/openalex_live_trace.csv",
            "counts": {
              "status_class": {"ok": 1}
            }
          }
        ]
      }
    },
    {
      "id": "live_crossref_verify_parses",
      "profiles": ["live"],
      "user_prompt": "Verify a known DOI against Crossref to confirm request construction and response parsing.",
      "dimensions": ["provider_integration", "crossref", "response_parsing"],
      "agent_expectation": {
        "skill_should_be_used": true,
        "surface": "cli",
        "_note": "Uses a well-known DOI to verify Crossref integration. Run manually after crossref_verify changes."
      },
      "timeout_seconds": 30,
      "command": [
        "{python}", "-m", "litminer.engine.run_lit_search",
        "--mode", "balanced",
        "--input-csv", "{fixture_live_doi}",
        "--skip-unpaywall",
        "--no-cache",
        "--output-dir", "{output_dir}"
      ],
      "expect": {
        "exit_code": 0,
        "files_exist": [
          "{output_dir}/verified_candidates.csv"
        ],
        "csv": [
          {
            "path": "{output_dir}/verified_candidates.csv",
            "row_count": 1,
            "counts": {
              "crossref_status": {"verified": 1}
            }
          }
        ]
      }
    },
    {
      "id": "partial_stdout_should_not_claim_complete",
      "profiles": ["known_issue"],
      "user_prompt": "Stop after dedupe. The Agent should see a partial run and should not be told that triage artifacts exist.",
      "dimensions": ["partial_run", "stdout_contract", "artifact_contract"],
      "agent_expectation": {
        "skill_should_be_used": true,
        "surface": "cli",
        "must_report": ["partial", "no_triaged_artifact"],
        "_note": "This field documents intended Agent reasoning. It is not validated by the runner."
      },
      "command": [
        "{python}", "-m", "litminer.engine.run_lit_search",
        "--mode", "fast",
        "--input-csv", "{fixture_mixed}",
        "--stop-after-stage", "dedupe",
        "--output-dir", "{output_dir}"
      ],
      "expect": {
        "exit_code": 0,
        "stderr_not_contains": [
          "Litminer run complete",
          "Triaged candidates:"
        ],
        "files_exist": [
          "{output_dir}/agent_summary.json",
          "{output_dir}/run_manifest.json"
        ],
        "files_not_exist": [
          "{output_dir}/triaged_candidates.csv",
          "{output_dir}/publisher_queue.csv"
        ],
        "json": [
          {
            "path": "{output_dir}/agent_summary.json",
            "checks": [
              {"path": "run_status", "equals": "partial"},
              {"path": "partial", "equals": true}
            ]
          }
        ]
      }
    },
    {
      "id": "regex_rejection_should_be_clean",
      "profiles": ["known_issue"],
      "user_prompt": "The user supplied a dangerous regex concept. The Agent should get a clean validation error, not a traceback.",
      "dimensions": ["regex", "safety", "cli_validation"],
      "agent_expectation": {
        "skill_should_be_used": true,
        "surface": "cli",
        "must_refuse": ["disabled_regex"],
        "_note": "This field documents intended Agent reasoning. It is not validated by the runner."
      },
      "command": [
        "{python}", "-m", "litminer.engine.semantic_triage",
        "--input", "{fixture_mixed}",
        "--output", "{output_dir}/triaged.csv",
        "--required-concept", "danger=re:(a+)+",
        "--disable-regex-concepts"
      ],
      "expect": {
        "exit_code": 1,
        "stderr_contains": ["Regex concepts are disabled"],
        "stderr_not_contains": ["Traceback"]
      }
    },
    {
      "id": "publisher_queue_should_dedupe_doi",
      "profiles": ["known_issue"],
      "user_prompt": "Build the publisher inspection queue. The Agent should not inspect the same DOI twice.",
      "dimensions": ["publisher_queue", "dedupe", "doi"],
      "agent_expectation": {
        "skill_should_be_used": true,
        "surface": "cli",
        "must_not": ["duplicate_doi_queue_rows"],
        "_note": "This field documents intended Agent reasoning. It is not validated by the runner."
      },
      "command": [
        "{python}", "-m", "litminer.engine.build_publisher_queue",
        "--input", "{fixture_duplicate_doi}",
        "--output", "{output_dir}/publisher_queue.csv",
        "--fields-needed", "validation evidence"
      ],
      "expect": {
        "exit_code": 0,
        "files_exist": ["{output_dir}/publisher_queue.csv"],
        "csv": [
          {
            "path": "{output_dir}/publisher_queue.csv",
            "row_count": 2,
            "unique": ["doi"]
          }
        ]
      }
    }
  ]
}
